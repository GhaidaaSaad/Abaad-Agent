cat > .env.example << 'EOF'
# OpenAI API Key (required for DALL-E 3 and GPT)
OPENAI_API_KEY=your_openai_api_key_here

# Replicate API Token (required for MusicGen)
REPLICATE_API_TOKEN=your_replicate_api_token_here  

# Tripo3D API Key (required for 3D model generation)
TRIPO3D_API_KEY=your_tripo3d_api_key_here

# ElevenLabs API Key (required for sfx voice generation)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
EOF